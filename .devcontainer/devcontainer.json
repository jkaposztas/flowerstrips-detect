
{
  "name": "Pytorch Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "args": {
      "USERNAME": "jkaposztas",
      "USER_UID": "1009",
      "USER_GID": "1009"
    }
  },
  "runArgs": ["--gpus", "device=3"],
  "remoteUser": "jkaposztas",
  "updateRemoteUserUID": true,
  "forwardPorts": [9989],
  "mounts": [
    "source=/local2,target=/local2,type=bind"
    ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.vscode-jupyter-cell-tags",
        "ms-toolsai.vscode-jupyter-powertoys",
        "Maimonator.gpu-monitor",
        "Leonardo16.nvidia-gpu",
        "mutantdino.resourcemonitor",
        "ionutvmi.path-autocomplete"
      ]
    }
  },
  "features": {},
  "postCreateCommand": "",
  "postStartCommand": ""
}
